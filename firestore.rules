rules_version = '2';

// In2Size Firestore 보안 규칙
// 이 파일 전체를 Firebase 콘솔 > Firestore Database > 규칙 탭에 붙여넣고 "게시"하세요. (README.md 참고)
//
// 요약
// - users/{uid}        : 본인만 만들고 고침. 본인 + 그룹이 하나라도 겹치는 사람만 읽음
// - groups/{groupId}   : 문서 하나 읽기(get)는 로그인한 누구나 (초대 코드로 들어가기 전 인원 확인용),
//                        목록 조회는 불가. 초대 코드로 "나 자신만" 추가·나가기 가능, 최대 5명.
//                        이름은 멤버 누구나 바꿀 수 있음. 마지막 한 명이 나가면 그룹 삭제
//                        멤버 색 colors { uid: 1~5 }: 들어올 때 내 색 하나 추가(겹치지 않게), 나갈 때 내 색만 빠짐
// - inviteCodes/{code} : 코드 → 그룹 찾기용. 코드 하나 조회만 가능, 목록 조회 불가
// - 한 사람은 그룹 최대 3개: users.groupIds와 groups.memberIds는 항상 같은 요청에서 같이 바뀌어야 함
// - users/{uid}/workouts, workoutFavorites : 상세 운동 기록. 본인만
// - users/{uid}/workoutSummaries           : 운동 요약(종류·시간·칼로리·한마디). 본인이 쓰고, 그룹이 겹치는 사람이 읽음
// - users/{uid}/cheers                     : 받은 응원 반응. 그룹이 겹치는 사람이 누르고(내 기록엔 못 누름) 읽음
// - courses/{courseId}                     : 앱 안에서 올린 영상 코스. 올린 사람 + 공유된 그룹(groupIds) 멤버가 읽고, 올린 사람만 고치고 지움

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 공통 함수 ----------
    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function codePath(code) {
      return /databases/$(database)/documents/inviteCodes/$(code);
    }

    // 사용자 문서의 그룹 목록. 예전 형식(groupId 하나)도 목록으로 읽음
    function idsOf(data) {
      return data.get('groupIds', data.get('groupId', null) == null ? [] : [data.get('groupId', null)]);
    }

    // 이 요청 전 / 후의 내 그룹 목록
    function myIds() {
      return idsOf(get(userPath(me())).data);
    }

    function afterIds() {
      return idsOf(getAfter(userPath(me())).data);
    }

    // 이 사람과 그룹이 하나라도 겹침 (나 자신 포함). resource.data를 안 봐서 목록 조회에도 쓸 수 있음
    function sharesGroupWith(uid) {
      return uid == me() || idsOf(get(userPath(uid)).data).hasAny(myIds());
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function validNickname(name) {
      return name is string && name.size() >= 1 && name.size() <= 12;
    }

    function validGroupName(name) {
      return name is string && name.size() >= 1 && name.size() <= 20;
    }

    function validCode(code) {
      // 6글자. 헷갈리는 0, O, 1, I, L 제외 (js/group.js의 CODE_CHARS와 같게)
      return code is string && code.matches('^[A-HJKMNP-Z2-9]{6}$');
    }

    // ---------- 사용자 ----------
    match /users/{uid} {
      // 본인, 또는 그룹이 하나라도 겹치는 사람
      allow read: if signedIn() && (uid == me() || idsOf(resource.data).hasAny(myIds()));

      // 가입할 때 한 번 (그룹 없이 시작)
      allow create: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['nickname', 'email', 'groupIds', 'createdAt'])
        && validNickname(request.resource.data.nickname)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.groupIds == []
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn() && uid == me()
        && (isNicknameEdit() || isMigration() || isGroupAdd() || isGroupRemove() || isCheersSeen());

      allow delete: if false;

      function isNicknameEdit() {
        return changedKeys().hasOnly(['nickname']) && validNickname(request.resource.data.nickname);
      }

      // 새 반응 읽음 표시 (같이 탭을 보면)
      function isCheersSeen() {
        return changedKeys().hasOnly(['cheersSeenAt']) && request.resource.data.cheersSeenAt == request.time;
      }

      // 예전 형식 groupId(하나) → groupIds(목록)로 한 번 바꾸기. 값은 그대로 옮겨야 함
      function isMigration() {
        return !('groupIds' in resource.data)
          && changedKeys().hasOnly(['groupId', 'groupIds'])
          && !('groupId' in request.resource.data)
          && request.resource.data.groupIds == idsOf(resource.data);
      }

      // 그룹 하나 추가 (만들기·들어가기): 그 그룹 멤버 목록에 내가 실제로 들어가야 함. 최대 3개
      function isGroupAdd() {
        let before = resource.data.get('groupIds', null);
        let after = request.resource.data.groupIds;
        let added = after.removeAll(before);
        return before != null
          && changedKeys().hasOnly(['groupIds'])
          && after.size() == before.size() + 1
          && after.size() <= 3
          && after.hasAll(before)
          && added.size() == 1
          && me() in getAfter(groupPath(added[0])).data.memberIds;
      }

      // 그룹 하나 빼기 (나가기): 그 그룹 멤버 목록에서도 내가 빠져야 함 (그룹이 지워져도 됨)
      function isGroupRemove() {
        let before = resource.data.get('groupIds', null);
        let after = request.resource.data.groupIds;
        let removed = before.removeAll(after);
        return before != null
          && changedKeys().hasOnly(['groupIds'])
          && after.size() == before.size() - 1
          && before.hasAll(after)
          && removed.size() == 1
          && (!existsAfter(groupPath(removed[0])) || !(me() in getAfter(groupPath(removed[0])).data.memberIds));
      }

      // 운동 기록·운동 즐겨찾기: 본인만 읽고 씀 (무게·세트·심박수 같은 상세는 친구도 못 봄)
      // (구조는 eatsylog와 똑같이 맞춤)
      match /workouts/{workoutId} {
        allow read, write: if signedIn() && uid == me();
      }
      match /workoutFavorites/{favId} {
        allow read, write: if signedIn() && uid == me();
      }

      // 운동 요약: 그룹 친구에게 보여주는 부분만 (운동 기록과 같은 id). 본인만 씀
      match /workoutSummaries/{workoutId} {
        allow read: if signedIn() && sharesGroupWith(uid);
        allow create, update: if signedIn() && uid == me() && validSummary(request.resource.data);
        allow delete: if signedIn() && uid == me();

        function validSummary(d) {
          return d.keys().hasOnly(['date', 'kinds', 'totalSec', 'totalCalorie', 'comment', 'createdAt', 'updatedAt'])
            && d.keys().hasAll(['date', 'kinds', 'comment', 'updatedAt'])
            && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && d.kinds is list && d.kinds.size() <= 20
            && (d.get('totalSec', null) == null || d.totalSec is number)
            && (d.get('totalCalorie', null) == null || d.totalCalorie is number)
            && d.comment is string && d.comment.size() <= 50
            && (d.get('createdAt', null) == null || d.createdAt is timestamp)
            && d.updatedAt == request.time;
        }
      }

      // 받은 응원 반응: 문서 id = 기록id_누른사람_이모지 → 한 사람이 이모지마다 한 번만
      match /cheers/{cheerId} {
        allow read: if signedIn() && sharesGroupWith(uid);

        // 그룹이 겹치는 친구가, 내 기록이 아닌 기록에, 나 자신 이름으로만
        allow create: if signedIn() && uid != me()
          && request.resource.data.keys().hasOnly(['workoutId', 'from', 'emoji', 'createdAt'])
          && request.resource.data.from == me()
          && request.resource.data.emoji in ['clap', 'fire', 'muscle', 'heart']
          && request.resource.data.workoutId is string
          && cheerId == request.resource.data.workoutId + '_' + me() + '_' + request.resource.data.emoji
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(uid)/workoutSummaries/$(request.resource.data.workoutId))
          && sharesGroupWith(uid);

        // 누른 사람은 취소, 기록 주인은 기록을 지울 때 정리
        allow delete: if signedIn() && (uid == me() || resource.data.from == me());
        allow update: if false;
      }
    }

    // ---------- 그룹 ----------
    match /groups/{groupId} {
      // 멤버 색 (js/group.js의 MEMBER_COLORS와 같게)
      function validColor(c) {
        return c is int && c >= 1 && c <= 5;
      }

      function colorsBefore() {
        return resource.data.get('colors', {});
      }

      function colorsAfter() {
        return request.resource.data.get('colors', {});
      }

      // colors에서 바뀐 건 내 칸 하나뿐
      function onlyMyColorChanged() {
        return colorsAfter().diff(colorsBefore()).affectedKeys().hasOnly([me()]);
      }

      // 내 색을 새로 넣음: 전에는 없었고, 1~5 중 다른 멤버가 안 쓰는 색
      function myColorAdded() {
        return onlyMyColorChanged()
          && !(me() in colorsBefore())
          && me() in colorsAfter()
          && validColor(colorsAfter()[me()])
          && !(colorsAfter()[me()] in colorsBefore().values());
      }

      // id를 알아야만 읽을 수 있고, id는 초대 코드로만 알 수 있어요
      allow get: if signedIn();
      allow list: if false;

      // 새 그룹 만들기: 만든 사람 혼자로 시작 + 초대 코드 문서 + 내 groupIds에 추가를 한 번에
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'code', 'ownerId', 'memberIds', 'colors', 'createdAt'])
        && request.resource.data.colors.keys().hasOnly([me()])
        && validColor(request.resource.data.colors[me()])
        && validGroupName(request.resource.data.name)
        && request.resource.data.ownerId == me()
        && request.resource.data.memberIds == [me()]
        && validCode(request.resource.data.code)
        && request.resource.data.createdAt == request.time
        && !(groupId in myIds())
        && groupId in afterIds()
        && getAfter(codePath(request.resource.data.code)).data.groupId == groupId;

      allow update: if signedIn() && (
        isJoining(resource.data.memberIds, request.resource.data.memberIds) ||
        isLeaving(resource.data.memberIds, request.resource.data.memberIds) ||
        isRenaming() ||
        isClaimingColor()
      );

      // 마지막 한 명이 나갈 때만: 그룹과 초대 코드를 같이 지움
      allow delete: if signedIn()
        && resource.data.memberIds == [me()]
        && !(groupId in afterIds())
        && !existsAfter(codePath(resource.data.code));

      // 초대 코드로 들어가기: 나 자신만 추가, 결과 5명 이하, 내 groupIds에도 같이 추가, 내 색도 추가
      function isJoining(before, after) {
        return changedKeys().hasOnly(['memberIds', 'colors'])
          && myColorAdded()
          && !(me() in before)
          && after.size() == before.size() + 1
          && after.hasAll(before)
          && me() in after
          && after.size() <= 5
          && !(groupId in myIds())
          && groupId in afterIds();
      }

      // 나가기: 나 자신만 빠짐 (마지막 한 명이면 delete로), 내 groupIds에서도 같이 빠짐, 내 색도 비움
      function isLeaving(before, after) {
        return changedKeys().hasOnly(['memberIds', 'colors'])
          && onlyMyColorChanged()
          && !(me() in colorsAfter())
          && me() in before
          && after.size() == before.size() - 1
          && before.hasAll(after)
          && !(me() in after)
          && after.size() >= 1
          && !(groupId in afterIds());
      }

      // 이름 바꾸기: 멤버 누구나
      function isRenaming() {
        return changedKeys().hasOnly(['name'])
          && me() in resource.data.memberIds
          && validGroupName(request.resource.data.name);
      }

      // 색 기능 전에 만든 그룹: 멤버가 자기 색을 한 번 골라 넣음
      function isClaimingColor() {
        return changedKeys().hasOnly(['colors'])
          && me() in resource.data.memberIds
          && myColorAdded();
      }

      // 그룹 하위 컬렉션이 필요해지면 그 그룹 memberIds 기준으로 여기에 추가. 예:
      // match /{document=**} {
      //   allow read: if signedIn() && me() in get(groupPath(groupId)).data.memberIds;
      // }
    }

    // ---------- 올린 영상 코스 ----------
    // 문서 하나를 공유할 그룹들(groupIds)에 같이 보여줘요 (그룹마다 복사하지 않음). [] = 나만 보기
    // 목록은 where('ownerId','==',나) 와 그룹마다 where('groupIds','array-contains',그룹id)로 읽어요
    match /courses/{courseId} {
      function validCourse(d) {
        return d.keys().hasOnly(['ownerId', 'youtube', 'name', 'category', 'desc', 'emoji', 'groupIds', 'durationSec', 'createdAt', 'updatedAt'])
          && d.keys().hasAll(['ownerId', 'youtube', 'name', 'category', 'desc', 'emoji', 'groupIds', 'durationSec', 'createdAt', 'updatedAt'])
          && d.youtube is string && d.youtube.matches('^[A-Za-z0-9_-]{11}$')
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 30
          && d.category is string && d.category.size() >= 1 && d.category.size() <= 20
          && d.desc is string && d.desc.size() <= 60
          && d.emoji is string && d.emoji.size() >= 1 && d.emoji.size() <= 8
          && d.groupIds is list && d.groupIds.size() <= 3
          && (d.durationSec == null || (d.durationSec is int && d.durationSec > 0 && d.durationSec <= 36000))
          && d.updatedAt == request.time;
      }

      // 올린 사람, 또는 공유된 그룹 중 하나에 들어가 있는 사람
      allow read: if signedIn() && (resource.data.ownerId == me() || resource.data.groupIds.hasAny(myIds()));

      // 공유할 그룹은 내 그룹 중에서만
      allow create: if signedIn()
        && validCourse(request.resource.data)
        && request.resource.data.ownerId == me()
        && request.resource.data.createdAt == request.time
        && request.resource.data.groupIds.toSet().hasOnly(myIds().toSet());

      // 올린 사람만. 올린 사람·올린 시각은 그대로, 새로 넣는 그룹은 내 그룹이어야 함
      // (그룹을 나간 뒤에도 그 그룹을 빼거나 다른 칸을 고칠 수 있게, 이미 있던 그룹은 그대로 둬도 됨)
      allow update: if signedIn()
        && resource.data.ownerId == me()
        && validCourse(request.resource.data)
        && request.resource.data.ownerId == me()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.groupIds.toSet().difference(resource.data.groupIds.toSet()).hasOnly(myIds().toSet());

      allow delete: if signedIn() && resource.data.ownerId == me();
    }

    // ---------- 초대 코드 ----------
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;

      // 그룹을 새로 만드는 바로 그 요청에서만 생성
      allow create: if signedIn()
        && validCode(code)
        && request.resource.data.keys().hasOnly(['groupId', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && !exists(groupPath(request.resource.data.groupId))
        && getAfter(groupPath(request.resource.data.groupId)).data.ownerId == me()
        && getAfter(groupPath(request.resource.data.groupId)).data.code == code;

      // 그룹이 지워지는 바로 그 요청에서만 삭제 (마지막 멤버가 나갈 때)
      allow delete: if signedIn()
        && !existsAfter(groupPath(resource.data.groupId))
        && me() in get(groupPath(resource.data.groupId)).data.memberIds;

      allow update: if false;
    }
  }
}
