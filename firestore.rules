rules_version = '2';

// In2Size Firestore 보안 규칙
// 이 파일 전체를 Firebase 콘솔 > Firestore Database > 규칙 탭에 붙여넣고 "게시"하세요. (README.md 참고)
//
// 요약
// - users/{uid}        : 본인만 만들고 고침. 본인 + 같은 그룹 멤버만 읽음
// - groups/{groupId}   : 문서 하나 읽기(get)는 로그인한 누구나 (초대 코드로 들어가기 전 인원 확인용),
//                        목록 조회는 불가. 초대 코드로 "나 자신만" 추가 가능, 최대 5명
// - inviteCodes/{code} : 코드 → 그룹 찾기용. 코드 하나 조회만 가능, 목록 조회 불가
// - 한 사람은 그룹 하나에만: groupId가 이미 있으면 다른 그룹을 만들거나 들어갈 수 없음

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 공통 함수 ----------
    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function codePath(code) {
      return /databases/$(database)/documents/inviteCodes/$(code);
    }

    function myGroupId() {
      return get(userPath(me())).data.groupId;
    }

    function validNickname(name) {
      return name is string && name.size() >= 1 && name.size() <= 12;
    }

    function validCode(code) {
      // 6글자. 헷갈리는 0, O, 1, I, L 제외 (js/group.js의 CODE_CHARS와 같게)
      return code is string && code.matches('^[A-HJKMNP-Z2-9]{6}$');
    }

    // ---------- 사용자 ----------
    match /users/{uid} {
      // 본인, 또는 같은 그룹 멤버
      allow read: if signedIn() && (
        uid == me() ||
        (resource.data.groupId != null && resource.data.groupId == myGroupId())
      );

      // 가입할 때 한 번 (그룹 없이 시작)
      allow create: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['nickname', 'email', 'groupId', 'createdAt'])
        && validNickname(request.resource.data.nickname)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.groupId == null
        && request.resource.data.createdAt == request.time;

      // 닉네임 수정, 또는 그룹에 들어갈 때 groupId 설정 (그룹 문서에 내가 실제로 추가되는 경우만)
      allow update: if signedIn() && uid == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'groupId'])
        && validNickname(request.resource.data.nickname)
        && (
          request.resource.data.groupId == resource.data.groupId ||
          (
            resource.data.groupId == null
            && request.resource.data.groupId is string
            && me() in getAfter(groupPath(request.resource.data.groupId)).data.memberIds
          )
        );

      allow delete: if false;

      // 운동 기록·운동 즐겨찾기: 지금은 본인만 읽고 씀
      // (구조는 eatsylog와 똑같이 맞춤. 그룹 멤버가 요약을 볼지는 4단계에서 결정)
      match /workouts/{workoutId} {
        allow read, write: if signedIn() && uid == me();
      }
      match /workoutFavorites/{favId} {
        allow read, write: if signedIn() && uid == me();
      }
    }

    // ---------- 그룹 ----------
    match /groups/{groupId} {
      // id를 알아야만 읽을 수 있고, id는 초대 코드로만 알 수 있어요
      allow get: if signedIn();
      allow list: if false;

      // 새 그룹 만들기: 만든 사람 혼자로 시작 + 초대 코드 문서 + 내 groupId를 한 번에
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['code', 'ownerId', 'memberIds', 'createdAt'])
        && request.resource.data.ownerId == me()
        && request.resource.data.memberIds == [me()]
        && validCode(request.resource.data.code)
        && request.resource.data.createdAt == request.time
        && get(userPath(me())).data.groupId == null
        && getAfter(userPath(me())).data.groupId == groupId
        && getAfter(codePath(request.resource.data.code)).data.groupId == groupId;

      // 초대 코드로 들어가기: 나 자신만 추가, 결과 5명 이하, 내 groupId도 함께 설정
      allow update: if signedIn() && isJoining(resource.data.memberIds, request.resource.data.memberIds);

      allow delete: if false;

      function isJoining(before, after) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && !(me() in before)
          && after.size() == before.size() + 1
          && after.hasAll(before)
          && me() in after
          && after.size() <= 5
          && get(userPath(me())).data.groupId == null
          && getAfter(userPath(me())).data.groupId == groupId;
      }

      // 4단계(같이 탭)에서 그룹 멤버만 읽고 쓰는 하위 컬렉션 규칙을 여기에 추가. 예:
      // match /{document=**} {
      //   allow read: if signedIn() && me() in get(groupPath(groupId)).data.memberIds;
      // }
    }

    // ---------- 초대 코드 ----------
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;

      // 그룹을 새로 만드는 바로 그 요청에서만 생성
      allow create: if signedIn()
        && validCode(code)
        && request.resource.data.keys().hasOnly(['groupId', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && !exists(groupPath(request.resource.data.groupId))
        && getAfter(groupPath(request.resource.data.groupId)).data.ownerId == me()
        && getAfter(groupPath(request.resource.data.groupId)).data.code == code;

      allow update, delete: if false;
    }
  }
}
